MINIO_LICENSE=minio.license
MINIO_OPTS=""
# Public console URL (must match nginx :8445). Do not set MINIO_SERVER_URL to the
# public API URL — it breaks console login behind a reverse proxy.
MINIO_BROWSER_REDIRECT_URL=https://example.com:8445
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=put-your-password-here

MINIO_PATH=/path/to/minio/data
MINIO_LICENSE_PATH=/path/to/minio.license

# Optional (must be set on first run if needed)
MINIO_OBJECT_NAMING=extended
