'==============================================================
' 1) USE CASE DIAGRAM  (maps to §5 of the design doc)
'==============================================================
@startuml UniMarketplace_UseCases
title UniMarketplace — Use Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false

actor "Student\n(Freelancer)" as S
actor "Client\n(Employer)"   as C
actor "Admin / Ops"          as A
actor "Payment System\n(bKash/Nagad/Card/Bank)" as P
actor "Risk / Fraud\nEngine" as R
actor "Notification\nService" as N

rectangle "UniMarketplace" {

  package "Auth & Identity" {
    usecase "Sign up"               as UC_Signup
    usecase "Sign in / OAuth"       as UC_Signin
    usecase "Reset password"        as UC_Reset
    usecase "Verify email"          as UC_VEmail
    usecase "Verify phone OTP"      as UC_VPhone
    usecase "Manage devices /\nsessions" as UC_Devices
    usecase "Logout / revoke token" as UC_Logout
  }

  package "Verification & KYC" {
    usecase "Upload student ID (L3)"     as UC_StudentID
    usecase "Submit NID for L4"          as UC_NID
    usecase "Liveness selfie check"      as UC_Liveness
    usecase "Link bKash / bank for payout" as UC_LinkPayout
    usecase "Auto-downgrade after\ngrad + 24mo" as UC_Downgrade
    usecase "Verify business / individual\n(client)" as UC_ClientKYC
  }

  package "Profile & Skills" {
    usecase "Build profile"        as UC_Profile
    usecase "Add portfolio item"   as UC_Portfolio
    usecase "Take skill test"      as UC_SkillTest
    usecase "Earn skill badge"     as UC_Badge
    usecase "Update availability"  as UC_Avail
  }

  package "Jobs" {
    usecase "Post job"             as UC_PostJob
    usecase "Edit / pause / close" as UC_EditJob
    usecase "Browse / search jobs" as UC_BrowseJobs
    usecase "Save job /\nfollow client" as UC_SaveJob
    usecase "Boost / feature job"  as UC_BoostJob
    usecase "Budget validation"    as UC_BudgetVal
  }

  package "Bidding" {
    usecase "Submit proposal"      as UC_Bid
    usecase "Anti-spam check"      as UC_AntiSpam
    usecase "Withdraw proposal"    as UC_BidWithdraw
    usecase "Shortlist proposal"   as UC_Shortlist
    usecase "Reject proposal"      as UC_Reject
    usecase "Send counter-offer"   as UC_Counter
    usecase "Accept offer"         as UC_AcceptOffer
  }

  package "Contracts & Milestones" {
    usecase "Create contract"           as UC_Contract
    usecase "Define / approve milestones" as UC_Milestones
    usecase "Submit deliverable"        as UC_Deliver
    usecase "Request revision"          as UC_Revision
    usecase "Approve milestone"         as UC_Approve
    usecase "Auto-release on timer"     as UC_AutoRelease
  }

  package "Payments / Wallet / Escrow" {
    usecase "Deposit funds"     as UC_Deposit
    usecase "Fund escrow"       as UC_FundEscrow
    usecase "Release escrow"    as UC_Release
    usecase "Refund escrow"     as UC_Refund
    usecase "Cancel contract"   as UC_Cancel
    usecase "Request payout"    as UC_Payout
    usecase "Process payout"    as UC_PayoutDo
    usecase "View statement /\nledger" as UC_Statement
    usecase "Risk check on\nmoney movement" as UC_RiskCheck
  }

  package "Disputes" {
    usecase "Open dispute"        as UC_OpenDispute
    usecase "Submit evidence"     as UC_Evidence
    usecase "Mediate"             as UC_Mediate
    usecase "Issue decision"      as UC_Decision
    usecase "Appeal decision"     as UC_Appeal
    usecase "Post journal entry\n(decision settlement)" as UC_JournalDec
  }

  package "Communication" {
    usecase "Pre-bid restricted chat" as UC_PreChat
    usecase "Contact-info filter"     as UC_Filter
    usecase "Post-contract chat"      as UC_Chat
    usecase "Schedule meeting"        as UC_Schedule
    usecase "Join meeting"            as UC_Join
    usecase "Record meeting"          as UC_Record
  }

  package "Reputation" {
    usecase "Leave review"        as UC_Review
    usecase "Report fake review"  as UC_ReportReview
    usecase "Compute TrustScore"  as UC_Trust
  }

  package "Notifications" {
    usecase "Receive in-app /\nemail / SMS" as UC_Notify
    usecase "Manage preferences"            as UC_NotifyPrefs
  }

  package "Risk & Fraud" {
    usecase "Detect anomaly"        as UC_Anomaly
    usecase "Step-up authenticate"  as UC_StepUp
    usecase "Freeze account"        as UC_Freeze
    usecase "Unfreeze after review" as UC_Unfreeze
  }

  package "Admin Ops" {
    usecase "KYC review queue"       as UC_KYCQ
    usecase "Fraud queue"            as UC_FraudQ
    usecase "Recon exceptions"       as UC_Recon
    usecase "Manage taxonomy"        as UC_Taxonomy
    usecase "View reports"           as UC_Reports
    usecase "Manage feature flags"   as UC_Flags
    usecase "Audit logs"             as UC_Audit
  }

  package "External Payments" {
    usecase "Authorize charge"   as UC_Auth
    usecase "Send callback"      as UC_Callback
    usecase "Provide statement"  as UC_StmtIn
  }
}

