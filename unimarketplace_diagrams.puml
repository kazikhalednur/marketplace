'==============================================================
' 3) ESCROW LIFECYCLE — STATE DIAGRAM  (maps to §3.4)
'==============================================================
@startuml UniMarketplace_EscrowState
title Escrow Lifecycle (per milestone)

skinparam shadowing false
hide empty description

[*] --> DRAFT : contract created

DRAFT --> FUNDED            : client deposits +\nledger posts escrow_fund
FUNDED --> IN_REVIEW        : student submits deliverable
FUNDED --> REFUNDED         : cancel before work\n(both consent / admin)

IN_REVIEW --> RELEASED      : client approves\n/ auto-release timer
IN_REVIEW --> DISPUTED      : either party opens dispute

DISPUTED --> RELEASED       : admin: full release
DISPUTED --> REFUNDED       : admin: full refund
DISPUTED --> DECIDED_SPLIT  : admin: partial split\n(template journal)

RELEASED      --> [*]
REFUNDED      --> [*]
DECIDED_SPLIT --> [*]

' Cross-cutting freeze (risk / admin)
state FROZEN
FUNDED     --> FROZEN : risk / admin freeze
IN_REVIEW  --> FROZEN : risk / admin freeze
DISPUTED   --> FROZEN : risk / admin freeze
FROZEN     --> FUNDED    : unfreeze
FROZEN     --> IN_REVIEW : unfreeze
FROZEN     --> DISPUTED  : unfreeze

note right of FUNDED
  Money sits in
  user.escrow_hold[contract_id]
  Client cannot withdraw it.
end note

note right of RELEASED
  Journal:
  DR escrow_hold
    CR student.available  (80%)
    CR platform.revenue   (20%)
end note

note right of DECIDED_SPLIT
  Journal example (60/40):
  DR escrow_hold
    CR student.available  (48%)
    CR platform.revenue   (12%)
    CR client.available   (40%)
end note
@enduml


'==============================================================
' 4) SEQUENCE: DEPOSIT → FUND ESCROW → DELIVERY → RELEASE → PAYOUT
'    (maps to Appendix B of the design doc)
'==============================================================
@startuml UniMarketplace_Sequence_MoneyFlow
title End-to-end money flow: deposit → escrow → release → payout

skinparam shadowing false
autonumber

actor Client    as Cl
actor Student   as St
participant "API\n(Django ASGI)" as API
participant "Ledger\n(double-entry)" as L
participant "Escrow\nstate machine" as E
participant "Risk\nengine"          as R
participant "Outbox /\nNotifications" as O
participant "bKash / SSLCommerz\n(Gateway)"   as G

== Deposit (client tops up wallet) ==
Cl  -> API : POST /payments/init\n[Idempotency-Key]
API -> R   : score(deposit, client)
R   --> API: allow
API -> G   : create payment intent
G   --> API: redirect / token
API --> Cl : redirect URL
Cl  -> G   : authenticates + pays
G   -> API : signed callback
API -> G   : verify (server-to-server)
G   --> API: ok
API -> L   : post deposit journal\n(DR gw_settlement, CR client.available)
API -> O   : emit "wallet.credited"
O   --> Cl : in-app + email

== Fund escrow ==
Cl  -> API : POST /contracts/{id}/fund_escrow\n[Idempotency-Key]
API -> L   : check client.available >= amount
L  --> API : ok
API -> L   : post escrow_fund journal\n(DR client.available, CR escrow_hold[contract])
API -> E   : transition contract → FUNDED
API -> O   : emit "contract.funded"
O   --> St : notify

== Delivery ==
St  -> API : POST /milestones/{id}/submit
API -> E   : transition → IN_REVIEW
API -> O   : emit "milestone.submitted"
O   --> Cl : notify (auto-release timer started)

== Release ==
alt client approves
    Cl -> API : POST /milestones/{id}/approve
else auto-release timer fires (T+7d)
    API -> API : scheduled job triggers
end
API -> L   : post escrow_release journal\n(DR escrow_hold,\n  CR student.available 80%,\n  CR platform.revenue 20%)
API -> E   : transition → RELEASED
API -> O   : emit "milestone.released"
O   --> St : notify

== Payout ==
St  -> API : POST /payouts/request\n[Idempotency-Key]
API -> R   : score(payout, student)
R   --> API: allow / hold
API -> L   : post payout_pending journal\n(DR student.available, CR payout_in_flight)
API -> G   : submit B2C payout
G   -> API : callback success
API -> L   : post payout_settled journal\n(DR payout_in_flight, CR gw_settlement)
API -> O   : emit "payout.settled"
O   --> St : notify

== Reconciliation (nightly) ==
API -> G   : pull statement
G   --> API: txns + fees
API -> L   : match journal entries\nflag exceptions
@enduml


'==============================================================
' 5) LEDGER / ESCROW DATA MODEL — CLASS DIAGRAM  (maps to §3.2)
'==============================================================
@startuml UniMarketplace_LedgerModel
title Ledger & Escrow data model (double-entry)

hide empty members
skinparam classAttributeIconSize 0
skinparam shadowing false

class Account {
  + id : BIGSERIAL
  --
  owner_type : ENUM
  owner_id : BIGINT
  account_type : ENUM
  currency : CHAR(3)
  status : ENUM
  created_at, updated_at
  __ enum owner_type __
  user / platform / gateway /
  escrow / fees / suspense
  __ enum account_type __
  available / pending /
  escrow_hold / revenue /
  fees / tax_withheld /
  gateway_settlement /
  suspense / rounding
}

class JournalEntry {
  + id : BIGSERIAL
  --
  external_ref : VARCHAR(64) UNIQUE
  type : ENUM
  status : ENUM (pending|posted|reversed)
  metadata : JSONB
  created_by : ENUM
  created_at
  __ enum type __
  deposit / escrow_fund /
  escrow_release / escrow_refund /
  fee_charge / tax_withhold /
  payout / reversal /
  adjustment / chargeback /
  correction
}

class Posting {
  + id : BIGSERIAL
  --
  journal_entry_id : FK
  account_id : FK
  direction : ENUM (debit|credit)
  amount : NUMERIC(18,2)
  currency : CHAR(3)
  created_at
  __ invariant __
  per JournalEntry, per currency:
  sum(debits) == sum(credits)
}

class BalancesCache {
  + account_id : PK
  --
  balance : NUMERIC(18,2)
  as_of : TIMESTAMPTZ
}

class EscrowHold {
  + id : BIGSERIAL
  --
  contract_id : BIGINT
  milestone_id : BIGINT?
  account_id : FK Account
  state : ENUM
  funded_at, released_at, refunded_at
  __ enum state __
  DRAFT / FUNDED / IN_REVIEW /
  DISPUTED / DECIDED_SPLIT /
  RELEASED / REFUNDED / FROZEN
}

class IdempotencyKey {
  + key : PK
  --
  user_id : BIGINT
  request_hash : TEXT
  response_status : INT
  response_body : JSONB
  expires_at : TIMESTAMPTZ
}

class OutboxEvent {
  + id : BIGSERIAL
  --
  aggregate, aggregate_id
  type
  payload : JSONB
  status : ENUM
  attempts : INT
  next_attempt_at, dispatched_at
}

class AuditLog {
  + id : BIGSERIAL
  --
  prev_hash : TEXT
  hash : TEXT (= sha256(prev_hash + payload))
  actor_type, actor_id
  action, resource, resource_id
  diff : JSONB
  ip, device_id, request_id
  created_at
}

class ReconException {
  + id : BIGSERIAL
  --
  gateway_txn_id : FK?
  journal_entry_id : FK?
  reason : TEXT
  status : ENUM
  resolved_by, resolved_at
}

class GatewayTxn {
  + id : BIGSERIAL
  --
  gateway : TEXT
  gateway_txn_id : UNIQUE
  type, amount, fee, when
  raw : JSONB
}

JournalEntry "1" *-- "many" Posting : balances\n(debits = credits)
Account "1" o-- "many" Posting : referenced by
Account "1" -- "0..1" BalancesCache
EscrowHold "1" --> "1" Account : escrow_hold account
ReconException "1" --> "0..1" GatewayTxn
ReconException "1" --> "0..1" JournalEntry
GatewayTxn "1" ..> "0..1" JournalEntry : matched via external_ref
@enduml


'==============================================================
' 6) KYC / VERIFICATION TIER LADDER — STATE DIAGRAM  (maps to §B.1)
'==============================================================
@startuml UniMarketplace_KYCLadder
title Verification tier ladder (capabilities unlock per tier)

skinparam shadowing false
hide empty description

[*] --> L0_Anon

state L0_Anon       : Browse only
state L1_Email      : Email + password / Google\nProfile draft\nNo bidding / no posting
state L2_StudentEmail: University email OTP\n+ whitelist match\nUp to 5 active proposals\nWallet cap: BDT 5,000
state L3_StudentID  : Student ID + selfie liveness\n+ cohort cross-check\nUnlimited bids, take contracts\nWallet cap: BDT 50,000
state L4_KYC        : NID + phone + bKash/bank match\nWithdraw enabled (subject to AML)\nWallet uncapped
state L5_Trusted    : Tenure + clean record\nLower fees, priority support,\nearly-access features

L0_Anon --> L1_Email          : sign up
L1_Email --> L2_StudentEmail  : verify university email\n(university_registry match)
L2_StudentEmail --> L3_StudentID : student-ID OCR + liveness pass
L3_StudentID  --> L4_KYC      : NID + name match passes
L4_KYC        --> L5_Trusted  : tenure + reputation thresholds

' Auto-downgrade after grad+24mo
L4_KYC        --> L2_StudentEmail : grad + 24mo (auto)\nuntil re-verify
L3_StudentID  --> L2_StudentEmail : grad + 24mo (auto)
L5_Trusted    --> L4_KYC          : violation / inactivity decay

' Forced freeze (risk)
state Frozen
L2_StudentEmail --> Frozen : risk / admin freeze
L3_StudentID    --> Frozen : risk / admin freeze
L4_KYC          --> Frozen : risk / admin freeze
L5_Trusted      --> Frozen : risk / admin freeze
Frozen --> L4_KYC          : unfreeze (most common)
@enduml
