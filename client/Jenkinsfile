pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'docker compose -f client/compose.yaml build'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker compose -f client/compose.yaml up -d'
            }
        }
    }
}
