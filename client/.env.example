# Public site URL (share links, OAuth redirect fallback)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Django API
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000

# Google OAuth (client ID only — secret stays in server google_credentials.json)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must match an authorized redirect URI in Google Cloud Console
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/google-login

# Legacy alias (optional if NEXT_PUBLIC_GOOGLE_CLIENT_ID is unset)
NEXT_PUBLIC_CLIENT_ID=
