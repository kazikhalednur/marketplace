# Django
DEBUG=true
SERVER_TYPE=staging

# Paystation: sandbox (default) or live — URL is chosen from PAYSTATION_ENV, not separate URL vars.
PAYSTATION_ENV=sandbox
PAYSTATION_MARCHANT_ID=put_marchant_id_here
PAYSTATION_PASSWORD=put_password_here

# Live payments on staging (merchant portal credentials from paystation.com.bd):
# PAYSTATION_ENV=live
# PAYSTATION_MARCHANT_ID=your-live-merchant-id
# PAYSTATION_PASSWORD=your-live-password

PAYSTATION_REQUEST_TIMEOUT=30
